# ==============================================================================
# FitAI Frontend — Vite Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel), set VITE_API_URL in the Vercel project dashboard:
#   Project Settings → Environment Variables → VITE_API_URL
# ==============================================================================

# Backend API base URL (must end with /api/v1, NO trailing slash)
# Local development:
VITE_API_URL=http://localhost:8080/api/v1

# Production (Render backend) — replace with your actual Render service URL:
# VITE_API_URL=https://your-render-service-name.onrender.com/api/v1
